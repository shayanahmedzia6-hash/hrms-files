NODE_ENV=development
PORT=4100
# Same Atlas database as hrms-backend. No additional database.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/
MONGODB_DB_NAME=hrms
# Future private object store; no upload endpoints are enabled yet.
STORAGE_PROVIDER=not_configured
STORAGE_BUCKET=SET_WHEN_PROVIDER_CHOSEN
STORAGE_REGION=SET_WHEN_PROVIDER_CHOSEN
STORAGE_ACCESS_KEY=SET_WHEN_PROVIDER_CHOSEN
STORAGE_SECRET_KEY=SET_WHEN_PROVIDER_CHOSEN
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_OWN_RANDOM_TOKEN
